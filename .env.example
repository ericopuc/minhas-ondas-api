# Endereços da Open-Meteo (não exigem chave de acesso)
MARINE_API_URL=https://marine-api.open-meteo.com/v1/marine
FORECAST_API_URL=https://api.open-meteo.com/v1/forecast
API_EXTERNA_TIMEOUT=10

# Fuso horário das consultas e dos momentos do ranking
FUSO_HORARIO=America/Sao_Paulo
DIAS_PASSADOS=1
DIAS_PREVISAO=7

# Tempo (minutos) que os dados coletados ficam armazenados
CACHE_MINUTOS=60

# Distância máxima (km) até a célula de mar da API para aceitar o local
DISTANCIA_MAXIMA_MAR_KM=12

# Elevação máxima (m) do ponto escolhido; acima disso é considerado terra
ELEVACAO_MAXIMA_MAR_M=5
